{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // this will only be used if you are building the project as a full stack application via .net mvc, if you building the backend using .net api this connection string will exits only on the api appsettings.json
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=MyDatabase;Integrated Security=True;",
    "ApplicationDbContext": "Server=(localdb)\\mssqllocaldb;Database=ApplicationDbContext;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Authentication": {
    "Google": {
      "ClientId": "your_client_id_here",
      "ClientSecret": "your_client_secret_here"
    }
  },
  "ExternalApis": {
    "BookStoreApi": {
      "BaseUrl": "https://localhost:7048/api/",
      "TimeoutSeconds": 15
    }
  }
}
