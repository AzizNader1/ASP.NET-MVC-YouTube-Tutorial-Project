@model FirstMVCProject.ViewModels.UserViewModels.UpdateProfileViewModel

@{
    ViewData["Title"] = "Update Profile";
}

<style>
    .profile-page {
        min-height: calc(100vh - 80px);
        padding: 40px 16px;
        background: #f5f7fc;
    }

    .profile-container {
        max-width: 1000px;
        margin: 0 auto;
    }

    .profile-header {
        margin-bottom: 28px;
    }

        .profile-header h1 {
            margin-bottom: 8px;
            color: #202943;
            font-size: 30px;
            font-weight: 800;
        }

        .profile-header p {
            margin: 0;
            color: #7b849b;
            font-size: 15px;
        }

    .profile-card {
        overflow: hidden;
        background: #fff;
        border: 1px solid #edf0f7;
        border-radius: 20px;
        box-shadow: 0 12px 35px rgba(31, 41, 75, 0.07);
    }

    .profile-card-header {
        padding: 24px 30px;
        background: linear-gradient(135deg, #f1f0ff, #f5f8ff);
        border-bottom: 1px solid #edf0f7;
    }

        .profile-card-header h2 {
            margin: 0 0 6px;
            color: #252e49;
            font-size: 20px;
            font-weight: 750;
        }

        .profile-card-header p {
            margin: 0;
            color: #7b849b;
            font-size: 14px;
        }

    .profile-card-body {
        padding: 30px;
    }

    .profile-image-section {
        display: flex;
        align-items: center;
        gap: 22px;
        padding: 22px;
        margin-bottom: 30px;
        background: #fafaff;
        border: 1px solid #ecebff;
        border-radius: 16px;
    }

    .profile-image-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 100px;
        height: 100px;
        overflow: hidden;
        background: linear-gradient(135deg, #536dfe, #8b5cf6);
        border: 4px solid #fff;
        border-radius: 50%;
        box-shadow: 0 5px 18px rgba(91, 91, 220, 0.2);
    }

    .profile-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .profile-image-placeholder {
        color: #fff;
        font-size: 34px;
        font-weight: 800;
    }

    .profile-image-info h3 {
        margin: 0 0 7px;
        color: #252e49;
        font-size: 16px;
        font-weight: 750;
    }

    .profile-image-info p {
        margin: 0 0 14px;
        color: #7b849b;
        font-size: 13px;
        line-height: 1.6;
    }

    .form-section-title {
        margin-bottom: 20px;
        color: #252e49;
        font-size: 17px;
        font-weight: 750;
    }

    .form-label {
        display: block;
        margin-bottom: 9px;
        color: #38415b;
        font-size: 14px;
        font-weight: 650;
    }

    .form-control {
        min-height: 48px;
        padding: 12px 14px;
        color: #252e49;
        background-color: #fff;
        border: 1px solid #e2e6f0;
        border-radius: 10px;
        box-shadow: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .form-control:focus {
            border-color: #7164f3;
            box-shadow: 0 0 0 3px rgba(113, 100, 243, 0.12);
        }

        .form-control[type="file"] {
            height: auto;
            padding: 10px;
            background: #fff;
        }

    .text-danger {
        display: block;
        margin-top: 6px;
        font-size: 12px;
    }

    .validation-summary {
        margin-bottom: 20px;
        color: #b42318;
        font-size: 14px;
    }

    .profile-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 25px;
        margin-top: 30px;
        border-top: 1px solid #edf0f7;
    }

    .btn-profile {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 12px 22px;
        border: none;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        transition: transform 0.2s, box-shadow 0.2s;
        cursor: pointer;
    }

    .btn-save {
        color: #fff;
        background: linear-gradient(135deg, #536dfe, #8157ee);
        box-shadow: 0 5px 14px rgba(91, 91, 220, 0.2);
    }

        .btn-save:hover {
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 8px 18px rgba(91, 91, 220, 0.27);
        }

    .btn-cancel {
        color: #505a75;
        background: #f0f2f8;
    }

        .btn-cancel:hover {
            color: #252e49;
            background: #e6e9f2;
        }

    @@media (max-width: 576px) {
        .profile-page {
            padding: 25px 12px;
        }

        .profile-header h1 {
            font-size: 25px;
        }

        .profile-card-header,
        .profile-card-body {
            padding: 22px 18px;
        }

        .profile-image-section {
            align-items: flex-start;
            flex-direction: column;
            padding: 18px;
        }

        .profile-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .btn-profile {
            width: 100%;
        }
    }
</style>

<div class="profile-page">
    <div class="profile-container">

        <div class="profile-header">
            <h1>Update Profile</h1>
            <p>Manage your personal information and profile picture.</p>
        </div>

        <div class="profile-card">

            <div class="profile-card-header">
                <h2>Personal Information</h2>
                <p>Update the information associated with your account.</p>
            </div>

            <div class="profile-card-body">

                <form asp-controller="Users"
                      asp-action="Edit"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="validation-summary"></div>

                    <div class="profile-image-section">
                        <div class="profile-image-wrapper">
                            @if (!string.IsNullOrWhiteSpace(Model.ExistingImageUrl))
                            {
                                <img src="@Model.ExistingImageUrl"
                                     alt="Current profile picture"
                                     class="profile-image" />
                            }
                            else
                            {
                                <span class="profile-image-placeholder">A</span>
                            }
                        </div>

                        <div class="profile-image-info">
                            <h3>Profile Picture</h3>
                            <p>
                                Choose a new image to personalize your account.
                                Leave this field empty to keep your current picture.
                            </p>

                            <label asp-for="ProfileImage" class="form-label">
                                Choose New Image
                            </label>

                            <input asp-for="ProfileImage"
                                   type="file"
                                   class="form-control"
                                   accept="image/*" />

                            <span asp-validation-for="ProfileImage"
                                  class="text-danger"></span>
                        </div>
                    </div>

                    <h3 class="form-section-title">Account Details</h3>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label">
                                First Name
                            </label>

                            <input asp-for="FirstName"
                                   class="form-control"
                                   placeholder="Enter your first name" />

                            <span asp-validation-for="FirstName"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label">
                                Last Name
                            </label>

                            <input asp-for="LastName"
                                   class="form-control"
                                   placeholder="Enter your last name" />

                            <span asp-validation-for="LastName"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">
                                Email Address
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="Enter your email address" />

                            <span asp-validation-for="Email"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Address" class="form-label">
                                Address
                            </label>

                            <input asp-for="Address"
                                   class="form-control"
                                   placeholder="Enter your address" />

                            <span asp-validation-for="Address"
                                  class="text-danger"></span>
                        </div>
                    </div>

                    <div class="profile-actions">
                        <a asp-controller="Users"
                           asp-action="Dashboard"
                           class="btn-profile btn-cancel">
                            Cancel
                        </a>

                        <button type="submit" class="btn-profile btn-save">
                            Save Changes
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>