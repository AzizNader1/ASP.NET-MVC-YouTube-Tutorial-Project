@model FirstMVCProject.ViewModels.UserViewModels.UpdatePasswordViewModel

@{
    ViewData["Title"] = "Update Password";
}

<style>
    .password-page {
        min-height: calc(100vh - 80px);
        padding: 40px 16px;
        background: #f5f7fc;
    }

    .password-container {
        max-width: 700px;
        margin: 0 auto;
    }

    .password-header {
        margin-bottom: 28px;
    }

        .password-header h1 {
            margin-bottom: 8px;
            color: #202943;
            font-size: 30px;
            font-weight: 800;
        }

        .password-header p {
            margin: 0;
            color: #7b849b;
            font-size: 15px;
        }

    .password-card {
        overflow: hidden;
        background: #fff;
        border: 1px solid #edf0f7;
        border-radius: 20px;
        box-shadow: 0 12px 35px rgba(31, 41, 75, 0.07);
    }

    .password-card-header {
        padding: 24px 30px;
        background: linear-gradient(135deg, #f1f0ff, #f5f8ff);
        border-bottom: 1px solid #edf0f7;
    }

        .password-card-header h2 {
            margin: 0 0 6px;
            color: #252e49;
            font-size: 20px;
            font-weight: 750;
        }

        .password-card-header p {
            margin: 0;
            color: #7b849b;
            font-size: 14px;
        }

    .password-card-body {
        padding: 30px;
    }

    .password-field {
        margin-bottom: 22px;
    }

        .password-field label {
            display: block;
            margin-bottom: 8px;
            color: #374151;
            font-size: 14px;
            font-weight: 600;
        }

        .password-field .form-control {
            border: 1px solid #d1d5db;
            border-radius: 10px;
            padding: 12px 16px;
            font-size: 15px;
            transition: border-color .2s, box-shadow .2s;
        }

        .password-field .form-control:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        }

    .password-actions {
        display: flex;
        justify-content: flex-end;
        gap: 14px;
        margin-top: 30px;
        padding-top: 24px;
        border-top: 1px solid #edf0f7;
    }

    .btn-profile {
        padding: 12px 24px;
        border-radius: 12px;
        font-size: 15px;
        font-weight: 650;
        text-decoration: none;
        transition: all .2s;
        border: none;
        cursor: pointer;
    }

    .btn-cancel {
        color: #6b7280;
        background: #f3f4f6;
    }

        .btn-cancel:hover {
            color: #374151;
            background: #e5e7eb;
        }

    .btn-save {
        color: #fff;
        background: linear-gradient(135deg, #4965cf, #7354bd);
        box-shadow: 0 4px 14px rgba(99, 102, 241, 0.25);
    }

        .btn-save:hover {
            opacity: 0.95;
            box-shadow: 0 6px 18px rgba(99, 102, 241, 0.35);
        }

    .validation-summary {
        margin-bottom: 20px;
    }

        .validation-summary ul {
            margin: 0;
            padding-left: 20px;
            color: #dc2626;
            font-size: 14px;
        }
</style>

<div class="password-page">
    <div class="password-container">

        <div class="password-header">
            <h1>Update Password</h1>
            <p>Ensure your account stays secure by using a strong password.</p>
        </div>

        <div class="password-card">

            <div class="password-card-header">
                <h2>Change Password</h2>
                <p>Enter your current password and choose a new one with at least 8 characters.</p>
            </div>

            <div class="password-card-body">

                <form asp-controller="Users"
                      asp-action="UpdatePassword"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                    <div class="password-field">
                        <label asp-for="CurrentPassword">Current Password</label>
                        <input asp-for="CurrentPassword"
                               type="password"
                               class="form-control"
                               placeholder="Enter your current password"
                               autocomplete="current-password" />
                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                    </div>

                    <div class="password-field">
                        <label asp-for="NewPassword">New Password</label>
                        <input asp-for="NewPassword"
                               type="password"
                               class="form-control"
                               placeholder="Enter new password (min. 8 characters)"
                               autocomplete="new-password" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>

                    <div class="password-field">
                        <label asp-for="ConfirmNewPassword">Confirm New Password</label>
                        <input asp-for="ConfirmNewPassword"
                               type="password"
                               class="form-control"
                               placeholder="Repeat your new password"
                               autocomplete="new-password" />
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                    </div>

                    <div class="password-actions">
                        <a asp-controller="Users"
                           asp-action="Dashboard"
                           class="btn-profile btn-cancel">
                            Cancel
                        </a>

                        <button type="submit" class="btn-profile btn-save">
                            Change Password
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
