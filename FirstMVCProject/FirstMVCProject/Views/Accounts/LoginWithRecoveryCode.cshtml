@model FirstMVCProject.ViewModels.AccountViewModels.LoginWithRecoveryCodeViewModel

@{
    ViewData["Title"] = "Recovery Code Verification";
}

<style>
    .auth-page {
        padding: 2.5rem 0 3rem;
    }

    .auth-wrapper {
        max-width: 500px;
        margin: 0 auto;
    }

    .auth-header {
        margin-bottom: 2rem;
        text-align: center;
    }

    .auth-icon {
        width: 72px;
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.25rem;
        border-radius: 1.25rem;
        background: linear-gradient(135deg, #fef2f2, #fff1f2);
        color: #dc2626;
        font-size: 32px;
    }

    .auth-title {
        margin-bottom: .6rem;
        color: #212529;
        font-size: 2rem;
        font-weight: 700;
    }

    .auth-subtitle {
        max-width: 420px;
        margin: 0 auto;
        color: #6c757d;
        font-size: 15px;
        line-height: 1.6;
    }

    .auth-card {
        overflow: hidden;
        border: 1px solid #e9ecef;
        border-radius: 1.25rem;
        background: #fff;
        box-shadow: 0 10px 30px rgba(0, 0, 0, .06);
    }

    .auth-card-header {
        padding: 2rem 2rem 1.25rem;
        border-bottom: 1px solid #edf0f3;
        background: linear-gradient(135deg, #f8faff, #fbfaff);
    }

        .auth-card-header h2 {
            margin-bottom: .35rem;
            color: #212529;
            font-size: 1.25rem;
            font-weight: 700;
        }

        .auth-card-header p {
            margin-bottom: 0;
            color: #6c757d;
            font-size: .92rem;
        }

    .auth-card-body {
        padding: 2rem;
    }

    .auth-field {
        margin-bottom: 1.5rem;
    }

        .auth-field label {
            display: block;
            margin-bottom: .5rem;
            color: #343a40;
            font-size: .92rem;
            font-weight: 600;
        }

    .code-input {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 18px;
        letter-spacing: 2px;
        text-align: center;
        font-weight: 700;
        padding: 12px;
        border-radius: 12px;
        border: 2px solid #dce2ee;
        transition: border-color .2s, box-shadow .2s;
    }

    .code-input:focus {
        border-color: #dc2626;
        box-shadow: 0 0 0 4px rgba(220, 38, 38, .15);
    }

    .auth-submit {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        width: 100%;
        padding: .95rem 1.25rem;
        border: 0;
        border-radius: .85rem;
        background: linear-gradient(135deg, #dc2626, #b91c1c);
        color: #fff;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity .2s, transform .2s;
    }

    .auth-submit:hover {
        opacity: .95;
        color: #fff;
        transform: translateY(-1px);
    }

    .auth-card-footer {
        padding: 1.25rem 2rem;
        border-top: 1px solid #edf0f3;
        background: #fbfcfe;
        text-align: center;
    }

        .auth-card-footer p {
            margin-bottom: 0;
            color: #6c757d;
            font-size: .92rem;
        }

        .auth-card-footer a {
            color: #495fc4;
            font-weight: 600;
            text-decoration: none;
        }

        .auth-card-footer a:hover {
            text-decoration: underline;
        }
</style>

<div class="auth-page">
    <div class="container auth-wrapper">

        <div class="auth-header">
            <div class="auth-icon">&#128273;</div>
            <h1 class="auth-title">Emergency Recovery Login</h1>
            <p class="auth-subtitle">
                Enter one of the backup recovery codes you saved when enabling Two-Factor Authentication.
            </p>
        </div>

        <section class="auth-card">
            <div class="auth-card-header">
                <h2>Enter Backup Recovery Code</h2>
                <p>This will log you in without requiring your mobile device.</p>
            </div>

            <div class="auth-card-body">
                <form asp-action="LoginWithRecoveryCode"
                      asp-route-returnUrl="@Model.ReturnUrl"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom: 1rem;" role="alert"></div>

                    <div class="auth-field">
                        <label asp-for="RecoveryCode">Recovery Code</label>
                        <input asp-for="RecoveryCode"
                               class="form-control code-input"
                               autocomplete="off"
                               placeholder="XXXXX-XXXXX"
                               autofocus
                               required />
                        <span asp-validation-for="RecoveryCode" class="text-danger" style="font-size: 13px;"></span>
                    </div>

                    <button type="submit" class="auth-submit">
                        Verify Recovery Code &rarr;
                    </button>
                </form>
            </div>

            <div class="auth-card-footer">
                <p>
                    Remember your authenticator code?
                    <br />
                    <a asp-action="LoginWith2fa" asp-route-returnUrl="@Model.ReturnUrl">
                        Sign in with an authenticator code
                    </a>
                </p>
            </div>
        </section>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
