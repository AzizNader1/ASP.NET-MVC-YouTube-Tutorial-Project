@model FirstMVCProject.ViewModels.AccountViewModels.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
}

<style>
    .auth-page {
        padding: 2rem 0 3rem;
    }

    .auth-wrapper {
        max-width: 520px;
        margin: 0 auto;
    }

    .auth-header {
        margin-bottom: 2rem;
        text-align: center;
    }

    .auth-icon {
        width: 72px;
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.25rem;
        border-radius: 1.25rem;
        background: linear-gradient(135deg, #e8f0ff, #f2eaff);
        color: #495fc4;
    }

        .auth-icon svg {
            width: 36px;
            height: 36px;
        }

    .auth-title {
        margin-bottom: .6rem;
        color: #212529;
        font-size: 2rem;
        font-weight: 700;
    }

    .auth-subtitle {
        max-width: 420px;
        margin: 0 auto;
        color: #6c757d;
        line-height: 1.6;
    }

    .auth-card {
        overflow: hidden;
        border: 1px solid #e9ecef;
        border-radius: 1.25rem;
        background: #fff;
        box-shadow: 0 10px 30px rgba(0, 0, 0, .06);
    }

    .auth-card-header {
        padding: 2rem 2rem 1.25rem;
        border-bottom: 1px solid #edf0f3;
        background: linear-gradient(135deg, #f8faff, #fbfaff);
    }

        .auth-card-header h2 {
            margin-bottom: .35rem;
            color: #212529;
            font-size: 1.35rem;
            font-weight: 700;
        }

        .auth-card-header p {
            margin-bottom: 0;
            color: #6c757d;
            font-size: .95rem;
        }

    .auth-card-body {
        padding: 2rem;
    }

    .auth-field {
        margin-bottom: 1.35rem;
    }

        .auth-field label {
            display: block;
            margin-bottom: .5rem;
            color: #343a40;
            font-size: .92rem;
            font-weight: 600;
        }

    .auth-required {
        color: #dc3545;
    }

    .auth-card-body .form-control {
        border-radius: .75rem;
        padding: .85rem 1rem;
        border: 1px solid #ced4da;
    }

    .auth-submit {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        width: 100%;
        padding: .95rem 1.25rem;
        border: 0;
        border-radius: .85rem;
        background: linear-gradient(135deg, #495fc4, #6643b5);
        color: #fff;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity .2s, transform .2s;
    }

        .auth-submit:hover {
            opacity: .95;
            color: #fff;
            transform: translateY(-1px);
        }

    /* Google Button & Divider Styling */
    .auth-divider {
        display: flex;
        align-items: center;
        margin: 1.5rem 0;
        text-align: center;
    }

        .auth-divider::before,
        .auth-divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid #e5e7eb;
        }

        .auth-divider span {
            padding: 0 1rem;
            color: #9ca3af;
            font-size: 0.85rem;
            text-transform: uppercase;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

    .btn-google {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        width: 100%;
        padding: 0.85rem 1rem;
        background: #ffffff;
        color: #374151;
        border: 1px solid #d1d5db;
        border-radius: 0.85rem;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: background-color .2s, border-color .2s, box-shadow .2s;
    }

        .btn-google:hover {
            background: #f9fafb;
            border-color: #9ca3af;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
            color: #111827;
        }

    .google-icon {
        width: 20px;
        height: 20px;
        flex-shrink: 0;
    }

    .auth-card-footer {
        padding: 1.25rem 2rem;
        border-top: 1px solid #edf0f3;
        background: #fbfcfe;
        text-align: center;
    }

        .auth-card-footer p {
            margin-bottom: 0;
            color: #6c757d;
            font-size: .92rem;
        }

        .auth-card-footer a {
            color: #495fc4;
            font-weight: 600;
            text-decoration: none;
        }

            .auth-card-footer a:hover {
                text-decoration: underline;
            }

    .auth-note {
        margin-top: 1.5rem;
        text-align: center;
        color: #adb5bd;
        font-size: .88rem;
    }
</style>

<div class="auth-page">
    <div class="container auth-wrapper">

        <div class="auth-header">
            <div class="auth-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                    <polyline points="10 17 15 12 10 7" />
                    <line x1="15" y1="12" x2="3" y2="12" />
                </svg>
            </div>

            <h1 class="auth-title">Welcome Back</h1>
            <p class="auth-subtitle">
                Sign in to your account to continue exploring and managing your book collection.
            </p>
        </div>

        <section class="auth-card">
            <div class="auth-card-header">
                <h2>Sign In to Your Account</h2>
                <p>Enter your credentials or continue with Google.</p>
            </div>

            <div class="auth-card-body">

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger" style="border-radius: 10px; font-size: 14px; margin-bottom: 1.25rem;">
                        @TempData["ErrorMessage"]
                    </div>
                }

                <form asp-controller="Accounts"
                      asp-action="Login"
                      asp-route-returnUrl="@ViewData["ReturnUrl"]"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom: 1rem;" role="alert"></div>

                    <div class="auth-field">
                        <label asp-for="Email">
                            Email Address <span class="auth-required">*</span>
                        </label>
                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               autocomplete="email"
                               placeholder="name@example.com"
                               autofocus
                               required />
                        <span asp-validation-for="Email" class="text-danger" style="font-size: 13px;"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Password">
                            Password <span class="auth-required">*</span>
                        </label>
                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               autocomplete="current-password"
                               placeholder="Enter your password"
                               required />
                        <span asp-validation-for="Password" class="text-danger" style="font-size: 13px;"></span>
                    </div>

                    <button type="submit" class="auth-submit">
                        Sign In &rarr;
                    </button>
                </form>

                <!-- OR DIVIDER -->
                <div class="auth-divider">
                    <span>or</span>
                </div>

                <!-- GOOGLE SIGN IN BUTTON -->
                <form asp-controller="Accounts"
                      asp-action="ExternalLogin"
                      asp-route-returnUrl="@ViewData["ReturnUrl"]"
                      method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" name="provider" value="Google" class="btn-google">
                        <svg class="google-icon" viewBox="0 0 24 24">
                            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
                            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
                        </svg>
                        <span>Continue with Google</span>
                    </button>
                </form>

            </div>

            <div class="auth-card-footer">
                <p>
                    Don't have an account?
                    <a asp-controller="Accounts" asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                        Create an account
                    </a>
                </p>
            </div>
        </section>

        <p class="auth-note">
            Your next chapter is waiting.
        </p>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}