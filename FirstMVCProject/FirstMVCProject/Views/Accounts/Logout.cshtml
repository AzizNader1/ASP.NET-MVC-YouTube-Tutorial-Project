
@{
    ViewData["Title"] = "Sign Out";
}

<style>
    .logout-page {
        padding: 2.5rem 0 3rem;
    }

    .logout-wrapper {
        max-width: 560px;
        margin: 0 auto;
    }

    .logout-card {
        overflow: hidden;
        border: 1px solid #e9ecef;
        border-radius: 1rem;
        background: #fff;
        box-shadow: 0 5px 22px rgba(0, 0, 0, .05);
        text-align: center;
    }

    .logout-card-header {
        padding: 2.5rem 2rem 1.75rem;
        background: linear-gradient(135deg, #f4f7ff, #faf7ff);
        border-bottom: 1px solid #edf0f3;
    }

    .logout-icon {
        width: 88px;
        height: 88px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        border: 1px solid #e2e8ff;
        border-radius: 1.5rem;
        background: linear-gradient(135deg, #e8f0ff, #f2eaff);
        color: #495fc4;
    }

    .logout-icon svg {
        width: 42px;
        height: 42px;
    }

    .logout-eyebrow {
        margin-bottom: .6rem;
        color: #495fc4;
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
    }

    .logout-title {
        margin-bottom: .75rem;
        color: #212529;
        font-size: 2rem;
        font-weight: 700;
    }

    .logout-subtitle {
        max-width: 390px;
        margin: 0 auto;
        color: #6c757d;
        line-height: 1.75;
    }

    .logout-card-body {
        padding: 2rem;
    }

    .logout-question {
        margin-bottom: .5rem;
        color: #343a40;
        font-size: 1.1rem;
        font-weight: 700;
    }

    .logout-description {
        margin-bottom: 1.75rem;
        color: #6c757d;
        font-size: .92rem;
        line-height: 1.7;
    }

    .logout-actions {
        display: flex;
        flex-direction: column;
        gap: .75rem;
    }

    .logout-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        width: 100%;
        min-height: 48px;
        padding: .75rem 1.25rem;
        border: none;
        border-radius: .65rem;
        background: linear-gradient(135deg, #4965cf, #7354bd);
        color: #fff;
        font-size: .95rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: transform .2s ease, box-shadow .2s ease;
    }

    .logout-button:hover {
        color: #fff;
        box-shadow: 0 5px 15px rgba(73, 95, 196, .2);
        transform: translateY(-1px);
    }

    .logout-cancel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 48px;
        padding: .75rem 1.25rem;
        border: 1px solid #dee2e6;
        border-radius: .65rem;
        background: #fff;
        color: #495057;
        font-size: .95rem;
        font-weight: 600;
        text-decoration: none;
        transition: background .2s ease;
    }

    .logout-cancel:hover {
        background: #f8f9fa;
        color: #212529;
    }

    .logout-footer {
        padding: 1.25rem;
        border-top: 1px solid #edf0f3;
        background: #fcfcfe;
        color: #6c757d;
        font-size: .85rem;
    }

    .logout-footer p {
        margin: 0;
    }

    @@media (max-width: 576px) {
        .logout-page {
            padding-top: 1.25rem;
        }

        .logout-card-header {
            padding: 2rem 1.25rem 1.5rem;
        }

        .logout-card-body {
            padding: 1.5rem 1.25rem;
        }

        .logout-title {
            font-size: 1.65rem;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .logout-button,
        .logout-cancel {
            transition: none;
        }

        .logout-button:hover {
            transform: none;
        }
    }
</style>

<div class="container logout-page">
    <div class="logout-wrapper">

        <section class="logout-card">
            <header class="logout-card-header">
                <div class="logout-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.7"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="M10 17l5-5-5-5" />
                        <path d="M15 12H3" />
                        <path d="M12 3h6a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3h-6" />
                    </svg>
                </div>

                <p class="logout-eyebrow">Before you turn the last page</p>

                <h1 class="logout-title">Leaving so soon?</h1>

                <p class="logout-subtitle">
                    Your reading journey can always continue when you return.
                    Take a moment to decide whether you'd like to sign out.
                </p>
            </header>

            <div class="logout-card-body">
                <h2 class="logout-question">Would you like to sign out?</h2>

                <p class="logout-description">
                    You can sign back in anytime to continue managing your
                    personal book collection.
                </p>

                <div class="logout-actions">
                    <form asp-controller="Accounts"
                          asp-action="Logout"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit" class="logout-button">
                            <span aria-hidden="true">↗</span>
                            Yes, sign me out
                        </button>
                    </form>

                    <a asp-controller="Books"
                       asp-action="Index"
                       class="logout-cancel">
                        No, return to my library
                    </a>
                </div>
            </div>

            <footer class="logout-footer">
                <p>There is always another good book waiting for you.</p>
            </footer>
        </section>

    </div>
</div>
