@model FirstMVCProject.ViewModels.BookViewModels.EditBookViewModel

@{
    ViewData["Title"] = "Edit Book";
}

<style>
    .edit-page {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2.5rem 1rem 3rem;
    }

    .edit-header {
        margin-bottom: 2rem;
    }

    .edit-header h1 {
        color: #212529;
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: .5rem;
    }

    .edit-header p {
        color: #6c757d;
        margin-bottom: 0;
    }

    .edit-card {
        display: grid;
        grid-template-columns: 300px minmax(0, 1fr);
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0, 0, 0, .06);
    }

    .edit-cover {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.25rem;
        padding: 2rem;
        text-align: center;
        background: linear-gradient(145deg, #e8f0ff, #f2eaff);
        color: #495fc4;
    }

    .edit-cover svg {
        width: 100px;
        height: 100px;
    }

    .edit-cover h2 {
        font-size: 1.5rem;
        font-weight: 700;
        color: #303f8f;
        margin: 0;
    }

    .edit-cover p {
        color: #606ca0;
        font-size: .95rem;
        line-height: 1.6;
        margin: 0;
    }

    .edit-form-container {
        min-width: 0;
        padding: 2.25rem;
    }

    .form-heading {
        font-size: 1.4rem;
        font-weight: 700;
        color: #212529;
        margin-bottom: .5rem;
    }

    .form-description {
        color: #6c757d;
        font-size: .9rem;
        margin-bottom: 1.75rem;
    }

    .edit-form .form-label {
        color: #343a40;
        font-size: .9rem;
        font-weight: 600;
        margin-bottom: .5rem;
    }

    .edit-form .form-control,
    .edit-form .form-select {
        min-height: 46px;
        border-color: #dee2e6;
        border-radius: .6rem;
        padding: .65rem .85rem;
        background-color: #fff;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

    .edit-form .form-control:focus,
    .edit-form .form-select:focus {
        border-color: #86b7fe;
        box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .12);
    }

    .form-field {
        margin-bottom: 1.35rem;
    }

    .edit-actions {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #f1f3f5;
    }

    .edit-actions .btn {
        padding: .7rem 1.25rem;
        border-radius: .6rem;
        font-weight: 600;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        margin-top: 1.5rem;
        color: #6c757d;
        text-decoration: none;
        font-size: .95rem;
    }

    .back-link:hover {
        color: #0d6efd;
    }

    @@media (max-width: 700px) {
        .edit-page {
            padding-top: 1.5rem;
        }

        .edit-header h1 {
            font-size: 1.7rem;
        }

        .edit-card {
            grid-template-columns: 1fr;
        }

        .edit-cover {
            padding: 1.75rem 1rem;
            gap: .75rem;
        }

        .edit-cover svg {
            width: 65px;
            height: 65px;
        }

        .edit-cover h2 {
            font-size: 1.25rem;
        }

        .edit-form-container {
            padding: 1.5rem;
        }

        .edit-actions {
            flex-direction: column;
        }

        .edit-actions .btn {
            width: 100%;
        }
    }
</style>

<div class="edit-page">

    <div class="edit-header">
        <h1>Edit Book @ViewData["BooksCount"]</h1>
        <p>Update the information of a book in your library.</p>
    </div>

    <div class="edit-card">

        <div class="edit-cover">

           @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@(Model.ImageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? Model.ImageUrl : Url.Content("~/" + Model.ImageUrl.TrimStart('~', '/')))"
                         alt="@Model.BookName Cover"
                         class="img-fluid" />
                }
                else
                {
                    <div class="text-center text-secondary">
                        <p class="mb-0">No cover image available.</p>
                    </div>
                }

            <h2>Refine Your Library</h2>

            <p>
                Keep your collection accurate.
                Update the book details whenever needed.
            </p>

        </div>

        <div class="edit-form-container">

            <h2 class="form-heading">Book Information</h2>

            <p class="form-description">
                Modify the fields below and save your changes.
            </p>

            <form asp-action="Edit"
                  asp-controller="Books"
                  method="post"
                  class="edit-form" enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <input type="hidden" asp-for="Id" />

                <div class="form-field">
                    <label asp-for="BookName" class="form-label">
                        Book Name
                    </label>

                    <input asp-for="BookName"
                           class="form-control"
                           placeholder="Enter the book title" />

                    <span asp-validation-for="BookName"
                          class="text-danger small">
                    </span>
                </div>

                <div class="form-field">
                    <label asp-for="Author" class="form-label">
                        Author
                    </label>

                    <input asp-for="Author"
                           class="form-control"
                           placeholder="Enter the author's name" />

                    <span asp-validation-for="Author"
                          class="text-danger small">
                    </span>
                </div>

                <div class="form-field">
                    <label asp-for="Genre" class="form-label">
                        Genre
                    </label>

                    <select asp-for="Genre"
                            asp-items="Html.GetEnumSelectList<FirstMVCProject.Models.Genres>()"
                            class="form-select">
                        <option value="">-- Select a genre --</option>
                    </select>

                    <span asp-validation-for="Genre"
                          class="text-danger small">
                    </span>
                </div>

                <div class="form-field">
                    <label asp-for="ImageFile" class="form-label">
                        Book Image
                    </label>

                    <input asp-for="ImageFile"
                           type="file"
                           class="form-control"
                           placeholder="Select a book image"
                           accept=".jpg,.jpeg,.png,.gif"
                           size="5" />

                    <span asp-validation-for="ImageFile"
                          class="text-danger small"></span>
                </div>

                <div class="edit-actions">
                    <button type="submit" class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </form>

        </div>

    </div>

    <a asp-action="Index" class="back-link">
        &larr; Back to Books Library
    </a>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
