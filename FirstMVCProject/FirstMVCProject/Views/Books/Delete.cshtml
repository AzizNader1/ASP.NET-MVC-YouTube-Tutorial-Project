@model FirstMVCProject.ViewModels.BookViewModels.DeleteBookViewModel

@{
    ViewData["Title"] = "Delete Book";
}

<style>
    .delete-page {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2.5rem 1rem 3rem;
    }

    .delete-header {
        margin-bottom: 2rem;
    }

        .delete-header h1 {
            color: #212529;
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: .5rem;
        }

        .delete-header p {
            color: #6c757d;
            margin-bottom: 0;
        }

    .delete-warning {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        padding: 1.25rem 1.5rem;
        margin-bottom: 1.5rem;
        background: #fff5f5;
        border: 1px solid #f5c2c7;
        border-radius: .85rem;
        color: #842029;
    }

    .warning-icon {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #f8d7da;
        color: #b02a37;
    }

        .warning-icon svg {
            width: 22px;
            height: 22px;
        }

    .delete-warning h2 {
        font-size: 1.05rem;
        font-weight: 700;
        margin: 0 0 .35rem;
    }

    .delete-warning p {
        font-size: .9rem;
        line-height: 1.6;
        margin: 0;
    }

    .delete-card {
        display: grid;
        grid-template-columns: 300px minmax(0, 1fr);
        overflow: hidden;
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 1rem;
        box-shadow: 0 8px 30px rgba(0, 0, 0, .06);
    }

    .delete-cover {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.25rem;
        padding: 2rem;
        text-align: center;
        background: linear-gradient(145deg, #fff0f0, #f2eaff);
        color: #b02a37;
    }

        .delete-cover svg {
            width: 100px;
            height: 100px;
        }

        .delete-cover h2 {
            font-size: 1.4rem;
            font-weight: 700;
            color: #842029;
            margin: 0;
        }

        .delete-cover p {
            color: #8b6267;
            font-size: .9rem;
            line-height: 1.6;
            margin: 0;
        }

    .delete-content {
        min-width: 0;
        padding: 2.25rem;
        display: flex;
        flex-direction: column;
    }

    .book-title {
        color: #212529;
        font-size: 1.7rem;
        font-weight: 700;
        line-height: 1.4;
        overflow-wrap: anywhere;
        margin-bottom: 1.5rem;
    }

    .details-label {
        color: #6c757d;
        font-size: .8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        margin-bottom: .5rem;
    }

    .detail-item {
        padding: 1rem 0;
        border-bottom: 1px solid #f1f3f5;
    }

    .detail-value {
        color: #343a40;
        font-size: 1rem;
        font-weight: 500;
        overflow-wrap: anywhere;
        margin-bottom: 0;
    }

    .genre-badge {
        display: inline-block;
        padding: .4rem .85rem;
        border-radius: 50rem;
        background: #f1f3f5;
        color: #495057;
        font-size: .85rem;
        font-weight: 600;
    }

    .delete-actions {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #f1f3f5;
    }

        .delete-actions .btn {
            padding: .7rem 1.2rem;
            border-radius: .6rem;
            font-weight: 600;
        }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        margin-top: 1.5rem;
        color: #6c757d;
        text-decoration: none;
        font-size: .95rem;
    }

        .back-link:hover {
            color: #0d6efd;
        }

    @@media (max-width: 700px) {
        .delete-page {
            padding-top: 1.5rem;
        }

        .delete-header h1 {
            font-size: 1.7rem;
        }

        .delete-card {
            grid-template-columns: 1fr;
        }

        .delete-cover {
            padding: 1.75rem 1rem;
            gap: .75rem;
        }

            .delete-cover svg {
                width: 65px;
                height: 65px;
            }

            .delete-cover h2 {
                font-size: 1.2rem;
            }

        .delete-content {
            padding: 1.5rem;
        }

        .book-title {
            font-size: 1.45rem;
        }

        .delete-actions {
            flex-direction: column;
        }

            .delete-actions .btn {
                width: 100%;
            }
    }
</style>

<div class="delete-page">

    <div class="delete-header">
        <h1>Delete Book</h1>
        <p>Review the book information before confirming deletion.</p>
    </div>

    <div class="delete-warning">

        <div class="warning-icon">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@(Model.ImageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? Model.ImageUrl : Url.Content("~/" + Model.ImageUrl.TrimStart('~', '/')))"
                         alt="@Model.BookName Cover"
                         class="img-fluid" />
                }
                else
                {
                    <div class="text-center text-secondary">
                        <p class="mb-0">No cover image available.</p>
                    </div>
                }
        </div>

        <div>
            <h2>Are you sure you want to delete this book?</h2>
            <p>
                This action may permanently remove the book from your library.
                Please verify the details below before continuing.
            </p>
        </div>

    </div>

    <div class="delete-card">

        <div class="delete-cover">

           @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@(Model.ImageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? Model.ImageUrl : Url.Content("~/" + Model.ImageUrl.TrimStart('~', '/')))"
                         alt="@Model.BookName Cover"
                         class="img-fluid" />
                }
                else
                {
                    <div class="text-center text-secondary">
                        <p class="mb-0">No cover image available.</p>
                    </div>
                }

            <h2>Book to Remove</h2>

            <p>
                Check that this is the correct book
                before confirming your decision.
            </p>

        </div>

        <div class="delete-content">

            <div class="details-label">Book Title</div>

            <h2 class="book-title">
                @Model.BookName
            </h2>

            <div class="detail-item">
                <div class="details-label">Author</div>
                <p class="detail-value">
                    @Model.Author
                </p>
            </div>

            <div class="detail-item">
                <div class="details-label">Genre</div>
                <span class="genre-badge">
                    @Model.Genre
                </span>
            </div>

            <form asp-action="Delete"
                  asp-controller="Books"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div class="delete-actions">

                    <button type="submit"
                            class="btn btn-danger"
                            onclick="return confirm('Are you absolutely sure you want to delete this book?');">
                        Delete Book
                    </button>

                    <a asp-action="Index"
                       asp-controller="Books"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

    <a asp-action="Index"
       asp-controller="Books"
       class="back-link">
        &larr; Back to Books Library
    </a>

</div>
