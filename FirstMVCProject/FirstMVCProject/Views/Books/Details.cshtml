@model FirstMVCProject.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<style>
    .details-page {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2.5rem 1rem 3rem;
    }

    .details-header {
        margin-bottom: 2rem;
    }

    .details-header h1 {
        font-size: 2rem;
        font-weight: 700;
        color: #212529;
        margin-bottom: .5rem;
    }

    .details-header p {
        color: #6c757d;
        margin-bottom: 0;
    }

    .book-details-card {
        display: grid;
        grid-template-columns: minmax(260px, 340px) minmax(0, 1fr);
        overflow: hidden;
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 1rem;
        box-shadow: 0 8px 30px rgba(0, 0, 0, .06);
    }

    .book-details-cover {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 0;
        min-height: 360px;
        padding: 1.5rem;
        background: linear-gradient(145deg, #e8f0ff, #f2eaff);
    }

    .book-details-cover img {
        display: block;
        max-width: 100%;
        height: auto;
        max-height: 420px;
        object-fit: contain;
        border-radius: .5rem;
    }

    .book-details-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-width: 0;
        padding: 2.5rem;
    }

    .details-label {
        color: #6c757d;
        font-size: .8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: .5rem;
    }

    .details-book-title {
        font-size: 1.8rem;
        font-weight: 700;
        color: #212529;
        line-height: 1.4;
        overflow-wrap: anywhere;
        margin-bottom: 1.5rem;
    }

    .detail-item {
        padding: 1rem 0;
        border-bottom: 1px solid #f1f3f5;
    }

    .detail-value {
        font-size: 1.05rem;
        font-weight: 500;
        color: #343a40;
        overflow-wrap: anywhere;
        margin-bottom: 0;
    }

    .genre-badge {
        display: inline-block;
        align-self: flex-start;
        padding: .4rem .85rem;
        border-radius: 50rem;
        background: #e9f2ff;
        color: #0d6efd;
        font-size: .85rem;
        font-weight: 600;
    }

    .details-actions {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;
        margin-top: 2rem;
    }

    .details-actions .btn {
        padding: .7rem 1.2rem;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        margin-top: 1.5rem;
        color: #6c757d;
        text-decoration: none;
    }

    .back-link:hover {
        color: #0d6efd;
    }

    @@media (max-width: 700px) {
        .details-page {
            padding: 1.5rem 1rem 2rem;
        }

        .details-header h1 {
            font-size: 1.7rem;
        }

        .book-details-card {
            grid-template-columns: 1fr;
        }

        .book-details-cover {
            min-height: 220px;
        }

        .book-details-cover img {
            max-height: 320px;
        }

        .book-details-content {
            padding: 1.5rem;
        }

        .details-book-title {
            font-size: 1.5rem;
        }

        .details-actions {
            flex-direction: column;
        }

        .details-actions .btn {
            width: 100%;
        }
    }
</style>

<div class="details-page">

    <div class="details-header">
        <h1>Book Details</h1>
        <p>Explore the information about this book in your library.</p>
    </div>

    @if (Model == null)
    {
        <div class="alert alert-warning">
            Book not found.
            <a asp-action="Index" class="alert-link">
                Return to the library
            </a>
        </div>
    }
    else
    {
        <div class="book-details-card">

            <div class="book-details-cover">
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@(Model.ImageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? Model.ImageUrl : Url.Content("~/" + Model.ImageUrl.TrimStart('~', '/')))"
                         alt="@Model.BookName Cover"
                         class="img-fluid" />
                }
                else
                {
                    <div class="text-center text-secondary">
                        <p class="mb-0">No cover image available.</p>
                    </div>
                }
            </div>

            <div class="book-details-content">

                <span class="details-label">Book title</span>

                <h2 class="details-book-title">
                    @Model.BookName
                </h2>

                <div class="detail-item">
                    <div class="details-label">Book ID</div>
                    <p class="detail-value">@Model.Id</p>
                </div>

                <div class="detail-item">
                    <div class="details-label">Author</div>
                    <p class="detail-value">@Model.Author</p>
                </div>

                <div class="detail-item">
                    <div class="details-label">Genre</div>
                    <span class="genre-badge">@Model.Genre</span>
                </div>

                <div class="details-actions">
                    @if(User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-primary">
                            Edit Book
                        </a>
                    }

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Back to Library
                    </a>
                </div>

            </div>
        </div>

        <a asp-action="Index" class="back-link">
            &larr; Return to all books
        </a>
    }

</div>